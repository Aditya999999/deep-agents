# ForgeX Deep Agent Platform — Environment Configuration
# Copy to .env and fill in values

# Existing Azure-hosted Claude binding
AZURE_CLAUDE_API_KEY=REPLACE_ME
AZURE_CLAUDE_BASE_URL=REPLACE_ME
AZURE_CLAUDE_MODEL=claude-sonnet-4-5-forgex-rnd

# SQLite application database
DATABASE_URL=sqlite+aiosqlite:///./forgex_agent.db
CHECKPOINT_DB_PATH=./forgex_checkpoints.db

# Data root for agent files (skills, memory, uploads)
DATA_ROOT=./data

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Web search provider — select one: tavily, bing
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BING_SEARCH_API_KEY=

# Runtime tool security
HTTP_TOOL_ALLOWED_HOST_SUFFIXES=
HTTP_TOOL_BLOCK_PRIVATE_NETWORKS=true

# LangSmith (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=forgex-deepagent

# Dev controls
APP_ENV=development
DEBUG=false

# File upload limits
MAX_UPLOAD_SIZE_MB=50
ALLOWED_MIME_TYPES=application/pdf,text/plain,text/markdown,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/png,image/jpeg
